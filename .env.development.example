PORT=3002
# Comma-separated origins are supported by the small Calidraw-specific patch in src/index.ts.
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175

# PayPal Invoicing Configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

